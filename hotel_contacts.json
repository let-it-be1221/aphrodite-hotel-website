20ሆቴል,%20Addis%20ababa&amp;t=&amp;z=13&amp;ie=UTF8&amp;iwloc=&amp;output=embed\" scrolling=\"no\" marginheight=\"0\" marginwidth=\"0\"></iframe>  </div></div>\n<div class=\"gap-40\"></div>\n<form method=\"POST\" action=\"\" autocomplete=\"off\">\n<div class=\"row\">\n<div class=\"col-md-8\">\n \n<div class=\"contact-form\">\n<h3 class=\"column-title\">We love to hear</h3>\n \n<div class=\"form-group\">\n<label for=\"name\">\nName</label>\n<input type=\"text\" name=\"name\" class=\"form-control\" id=\"name\" placeholder=\"Enter name\" required=\"required\">\n</div>\n<div class=\"form-group\">\n<label for=\"email\">\nEmail address</label>\n<input type=\"email\" name=\"email\" class=\"form-control\" id=\"email\" placeholder=\"Enter email\" required=\"required\">\n</div>\n<div class=\"form-group\">\n<label for=\"subject\">\nSubject</label>\n<input type=\"text\" name=\"subject\" class=\"form-control\" placeholder=\" Subject\">\n</div> \n<div class=\"form-group\">\n<label for=\"name\">\nMessage</label>\n<textarea name=\"message\" id=\"message\" class=\"form-control\" rows=\"9\" cols=\"25\" required=\"required\" placeholder=\"Message\"></textarea>\n</div>  \n<div class=\"text-right\"><br>\n<button type=\"submit\" class=\"btn btn-primary solid blank\" id=\"btnContactUs\">\nSend Message</button>\n</div>\n \n</div>\n</div>\n<div class=\"col-md-4\">\n<div class=\"contact-details\">\n<h3>Contact detail</h3>\n<address>\n<p>Aphrodite International Hotel • Mobile: +251-94-760-4545 • Tel: +251-11-557-2228/29 • WhatsApp: +251-94-760-4545 • Email: info@aphroditeaddis.com/markating@aphroditeaddis.com/reservations@aphroditeaddis.com • Kasanchis Business District, a walking distance from/ to the main entrance of the United Nation Economic Commission for Africa (UNECA) headquarter.&nbsp;</p>\n\n<p align=\"center\">Addis Ababa, Ethiopia</p>\n</address>\n</div>\n</div>\n</div></form>\n\n</div><!-- Conatiner end -->\n</section><!-- Main container end -->  <footer id=\"footer\" class=\"foote